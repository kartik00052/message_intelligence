# Message Intelligence pipeline configuration.
# Copy to `.env` and adjust as needed. Defaults match `app/config.py`; all
# variables are optional.

# ---- Paths ------------------------------------------------------------------
MESSAGES_CSV_PATH=./messages.csv
MANDATORY_DEMO_IDS_PATH=./mandatory_demo_ids.csv
OUTPUTS_DIR=./outputs

# ---- Dataset expectations ---------------------------------------------------
EXPECTED_MESSAGE_COUNT=900
EXPECTED_MANDATORY_COUNT=15

# ---- LLM fallback (optional; fully offline by default) ---------------------
# The pipeline runs entirely on deterministic rules when LLM_ENABLED=false or
# no key/model is configured. Never commit a real API key.
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
# Rule confidence below which the LLM fallback classifier is consulted.
LLM_CONFIDENCE_THRESHOLD=0.75
